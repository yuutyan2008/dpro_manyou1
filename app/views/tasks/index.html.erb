<h1><%= t('view.tasks.index.title') %></h1>

<%# 検索機能フォームのデザインを Bootstrap で適用 %>
<%= form_with(url: tasks_path, method: :get, local: true, class: 'form-inline') do |form| %>
<div class="form-group mx-sm-3 mb-2">
  <%= form.label :status, t('activerecord.attributes.task.status') %>
  <%= form.select :status, [['未着手', 'not_started'], ['着手中', 'under_way'], ['完了', 'completed']], include_blank: true, selected: params[:status], class: "form-control" %>
</div>

<div class="form-group mx-sm-3 mb-2">
  <%= form.label :title, t('activerecord.attributes.task.title'), for: "search_title" %>
  <%= form.text_field :title, value: params[:title], id: "search_title", class: "form-control" %>
</div>

<div class="form-group mx-sm-3 mb-2">
  <%= form.label :label, t('activerecord.attributes.label.label') %>
  <select name="search[label]" id="search_label" class="form-control">
    <option value=""></option> <%# 空のオプションを追加 %>
    <% @labels.each do |label| %>
    <option value="<%= label.id %>"><%= label.name %></option>
    <% end %>
  </select>
</div>

<%= form.submit "検索", class: "btn btn-info", id: "search_task" %>
<% end %>

<% if @tasks.any? %>
<table class="table table">
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th><%= link_to t('activerecord.attributes.task.deadline_on'), { sort_deadline_on: true, page: params[:page] } %>
      </th>
      <th><%= link_to t('activerecord.attributes.task.priority'), { sort_priority: true, page: params[:page] } %></th>
      <th><%= Task.human_attribute_name(:status) %></th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td class="task-title"><%= task.title %></td>
      <td class="task-content"><%= task.content %></td>
      <td class="task-created_at"><%= task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
      <td class="deadline_on"><%= task.deadline_on.strftime("%Y-%m-%d") %></td>
      <td><%= I18n.t("activerecord.enums.task.priority.#{task.priority}") %></td>
      <td><%= I18n.t("activerecord.enums.task.status.#{task.status}") %></td>
      <td><%= link_to t('common.show'), task, class: 'btn btn-info' %></td>
      <td><%= link_to t('common.edit'), edit_task_path(task), class: 'btn btn-info' %></td>
      <td>
        <%= link_to t('common.destroy'), task, method: :delete, data: { confirm: t('common.confirm_destroy') }, class: 'btn btn-outline-danger' %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>
<% else %>
<p>まだタスクがありません。</p>
<% end %>
