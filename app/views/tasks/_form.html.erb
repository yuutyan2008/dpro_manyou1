<%= form_with(model: task, local: true) do |form| %>

<% if task.errors.any? %>
<div id="error_explanation" class="alert alert-danger">
  <h2><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</h2>

  <ul>
    <% task.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="form-group">
  <%= form.label :title %>
  <%= form.text_field :title, class: "form-control" %>
</div>

<div class="form-group">
  <%= form.label :content %>
  <%= form.text_area :content, class: "form-control" %>
</div>

<div class="form-group">
  <%= form.label :deadline_on %>
  <%= form.date_field :deadline_on, min: Date.current, class: "form-control" %>
</div>

<div class="form-group">
  <%= form.label :priority %>
  <%= form.select :priority, options_for_select([['低', 'low'], ['中', 'middle'], ['高', 'high']], task.priority), { include_blank: true }, class: "form-control" %>
</div>

<div class="form-group">
  <%= form.label :status %>
  <%= form.select :status, options_for_select([['未着手', 'not_started'], ['着手中', 'under_way'], ['完了', 'completed']], task.status), { include_blank: true }, class: "form-control" %>
</div>

<%# labelの選択機能を追加 %>
<div class="form-group">
  <%= form.label :labels, 'ラベル' %>
  <% Label.all.each do |label| %>
  <div class="form-check">
    <%= form.check_box :label_ids, { multiple: true, include_hidden: false, class: "form-check-input" }, label[:id], nil %>

    <%= form.label "label_ids_#{label.id}", label.name, class: "form-check-label" %>
  </div>
  <% end %>
</div>

<div class="form-group">
  <%= form.submit button_label, class: "btn btn-primary", id: 'create-task' %>
</div>

<% end %>
